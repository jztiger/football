# Get a free key at https://the-odds-api.com (500 requests/month on the free tier).
# Leave unset to run on built-in mock data.
ODDS_API_KEY=

# Cache window for odds fetches, in seconds. Keeps you inside the free quota.
ODDS_CACHE_SECONDS=600

# Comma-separated bookmaker regions to request: us, us2, uk, eu, au
ODDS_REGIONS=us
